# Скопируйте в .env и раскомментируйте то, что хотите поменять.
# HANDAPP_MODEL=Qwen/Qwen3-VL-8B-Instruct   # по умолчанию 8B на видеокарте NVIDIA, 2B на Mac
# HANDAPP_QUANT=4bit                         # 4bit (влезает в 12 ГБ) или none
# HANDAPP_MAX_PIXELS=1254400                 # детализация фото: больше = точнее, но медленнее
# HANDAPP_AUTOFIX_MIN=2                      # сколько раз исправить слово, чтобы оно правилось само
# HANDAPP_OCR=mock                           # тестовый режим без модели
